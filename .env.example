# ========================================================
# SDR-Recorder NVR Environment Configuration
# ========================================================

# Web & WebSocket Port on Host
SDR_PORT=8000

# Host Server Timezone (e.g. Asia/Jakarta, Asia/Jayapura, UTC)
TZ=Asia/Jayapura

# Security & Authentication (Change JWT_SECRET in production!)
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=12345

# Initial Radio Defaults
DEFAULT_FREQUENCY_HZ=118200000
DEFAULT_MODULATION=AM
DEFAULT_SQUELCH_THRESHOLD=-42.0

# Audio & Storage Retention
DEFAULT_AUDIO_FORMAT=opus
DEFAULT_RETENTION_DAYS=14
DEFAULT_MAX_DISK_USAGE_PERCENT=90
